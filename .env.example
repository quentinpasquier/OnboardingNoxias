# =============================================================================
# Noxias Prospection Builder — variables d'environnement
# =============================================================================

# --- Anthropic (Claude API) — REQUIS ---
ANTHROPIC_API_KEY=sk-ant-xxx
# Optionnel : remplace claude-opus-4-7 par claude-sonnet-4-6 pour ~3x moins cher
ANTHROPIC_MODEL=claude-opus-4-7

# --- Supabase (auth + storage) — REQUIS ---
# Crée un projet sur https://supabase.com puis copie les valeurs depuis
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role key — utile pour le seed admin / migrations programmatiques.
# NE JAMAIS exposer côté client. Optionnel pour V1.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
